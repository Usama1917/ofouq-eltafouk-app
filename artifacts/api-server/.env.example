# ── Core (required) ───────────────────────────────────────────────────────────
PORT=8080
# Use `production` on the live server. In development the API returns verbose
# error details to clients and uses pretty logs — never run prod as development.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ofouq_eltafouk

# ── Security (required in production) ──────────────────────────────────────────
# Long random secret used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production without it.
AUTH_SECRET=
# Comma-separated list of browser origins allowed to call the API (admin web, etc.).
# Example: https://app.eltafouk.com,https://admin.eltafouk.com
ALLOWED_ORIGINS=

# ── Database TLS (managed Postgres) ────────────────────────────────────────────
# When DATABASE_URL contains `?sslmode=require` TLS is enabled automatically.
# Optionally pin the provider CA certificate (PEM contents) to verify the chain:
# DATABASE_CA_CERT=
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=10

# ── AI assistant (optional / deferred) ─────────────────────────────────────────
# Point these at a real provider to enable the AI assistant (was Replit-injected).
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_INTEGRATIONS_OPENAI_API_KEY=
# YOUTUBE_DATA_API_KEY=

# Do NOT set AUTH_DEBUG in production (it leaks internal error details to clients).
